# Reference fragments for the existing SyncWatch Nginx configuration.
# Review paths/certificates against the host; do not paste over unrelated vhosts.

# Define this once in the Nginx http context, outside all server blocks.
log_format syncwatch_safe '$remote_addr - $remote_user [$time_local] '
                          '"$request_method $uri $server_protocol" '
                          '$status $body_bytes_sent '
                          '"$http_user_agent"';

# HTTP-to-HTTPS redirect vhost.
server {
    listen 80;
    listen [::]:80;
    server_name play.projectdarkhope.xyz;
    return 301 https://$host$request_uri;
}

# Add the remaining directives to the existing SyncWatch HTTPS server block.
# Keep the host's current listen 443 ssl and certificate directives.
server_tokens off;
root /var/www/syncwatch;
index index.html;
access_log /var/log/nginx/syncwatch-access.log syncwatch_safe;

add_header Strict-Transport-Security "max-age=31536000" always;
add_header Content-Security-Policy "frame-ancestors 'none'" always;
add_header X-Frame-Options "DENY" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;

# Ensure the PWA manifest has the correct MIME type even if the host mime.types
# file does not define the webmanifest extension.
location = /manifest.webmanifest {
    try_files $uri =404;
    default_type application/manifest+json;
}

# Keep this more-specific stream location before the generic API proxy.
location ^~ /api/stream/ {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Range $http_range;
    proxy_set_header If-Range $http_if_range;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}

location /api/ {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /ws {
    proxy_pass http://127.0.0.1:8080/ws;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_cache_bypass $http_upgrade;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}

# SPA fallback and static PWA files. API/WebSocket locations above remain
# separate and are never routed through index.html.
location / {
    try_files $uri $uri/ /index.html;
}
